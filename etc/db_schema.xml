<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="sanjeev_customer_purchase_history" resource="default" engine="innodb" comment="Customer Purchase History Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>

        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store Id"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer Id"/>
        <column xsi:type="decimal" name="total_purchase_amount" scale="4" precision="20" unsigned="false"
                nullable="true" comment="Total Purchase Amount"/>
        <column xsi:type="decimal" name="avg_purchase_amount" scale="4" precision="20" unsigned="false"
                nullable="true" comment="Average Purchase Amount"/>
        <column xsi:type="varchar" name="currency_code"  length="3" nullable="true" comment="Currency Code"/>
        <column xsi:type="datetime" name="last_purchase_date" on_update="false" nullable="true" comment="Last Purchase Date"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="FK_CUSTOMER_PURCHASE_HISTORY_CUSTOMER_ID" table="sanjeev_customer_purchase_history" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="FK_CUSTOMER_PURCHASE_HISTORY_STORE_ID" table="sanjeev_customer_purchase_history" column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
</schema>
